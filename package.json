  "description": "Local-first desktop cockpit for running several official Claude Code and Codex CLI sessions side by side",
  "license": "Apache-2.0",
  "author": "Robert Bansimer",
  "homepage": "https://github.com/darkcool70/robs-ai-cockpit",
