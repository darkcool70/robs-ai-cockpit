{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Robs AI Cockpit",
  "mainBinaryName": "RobsAICockpit",
  "version": "0.2.0",
  "identifier": "io.github.darkcool70.robsaicockpit",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Robs AI Cockpit",
        "width": 1480,
        "height": 920,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#0d1014",
        "backgroundThrottling": "disabled",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,IntensiveWakeUpThrottling,CalculateNativeWinOcclusion --disable-background-timer-throttling --disable-renderer-backgrounding --disable-backgrounding-occluded-windows"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Robert Bansimer",
    "copyright": "Copyright 2026 Robert Bansimer. Licensed under the Apache License 2.0.",
    "homepage": "https://github.com/darkcool70/robs-ai-cockpit",
    "category": "DeveloperTool",
    "shortDescription": "Run several Claude Code and Codex CLI sessions side by side",
    "licenseFile": "../LICENSE",
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
